{
    "Comment": "An ingestion pipeline that gets triggered by API GW",
    "StartAt": "Generate Commit ID",
    "States": {
        "Generate Commit ID": {
            "Type": "Pass",
            "Assign": {
                "campaign_id.$": "$.campaign_id",
                "commit_id.$": "States.UUID()"
            },
            "Parameters": {
                "Bucket.$": "$.bucket",
                "Key.$": "$.key",
                "campaign_id.$": "$.campaign_id"
            },
            "Next": "S3 CSV file Ingestion"
        },
        "S3 CSV file Ingestion": {
            "Type": "Map",
            "Assign": {
                "campaign_id.$": "$campaign_id",
                "commit_id.$": "$commit_id"
            },
            "ItemSelector": {
                "items.$": "$$.Map.Item.Value",
                "commit_id.$": "$commit_id",
                "campaign_id.$": "$campaign_id"
            },
            "ItemProcessor": {
                "ProcessorConfig": {
                    "Mode": "DISTRIBUTED",
                    "ExecutionType": "STANDARD"
                },
                "StartAt": "Validate input format",
                "States": {
                    "Validate input format": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "ResultPath": "$.validation",
                        "Parameters": {
                            "FunctionName": "${ValidateRawValidFormatFunctionArn}",
                            "Payload.$": "$"
                        },
                        "Catch": [
                            {
                                "ErrorEquals": ["States.ALL"],
                                "Next": "Prepare Failure Message",
                                "ResultPath": "$.error"
                            }
                        ],
                        "Next": "Choice"
                    },
                    "Choice": {
                        "Type": "Choice",
                        "Choices": [
                            {
                                "Variable": "$.validation.Payload.isValidInputFormat",
                                "BooleanEquals": true,
                                "Next": "Mapping to output format"
                            }
                        ],
                        "Default": "Standardize with OpenAI"
                    },
                    "Mapping to output format": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "ResultPath": "$.standardization",
                        "Parameters": {
                            "FunctionName": "${MappingRawValidInputFunctionArn}",
                            "Payload.$": "$"
                        },
                        "Catch": [
                            {
                                "ErrorEquals": ["States.ALL"],
                                "Next": "Prepare Failure Message",
                                "ResultPath": "$.error"
                            }
                        ],
                        "Next": "Process standardized data"
                    },
                    "Standardize with OpenAI": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "ResultPath": "$.standardization",
                        "Parameters": {
                            "FunctionName": "${StandardizationFunctionArn}",
                            "Payload.$": "$"
                        },
                        "Catch": [
                            {
                                "ErrorEquals": ["States.ALL"],
                                "Next": "Prepare Failure Message",
                                "ResultPath": "$.error"
                            }
                        ],
                        "Next": "Process standardized data"
                    },
                    "Process standardized data": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "Parameters": {
                            "FunctionName": "${ProcessStandardizedDataFunctionArn}",
                            "Payload": {
                                "data.$": "$",
                                "executionId.$": "$$.Execution.Name"
                            }
                        },
                        "OutputPath": "$.Payload",
                        "Catch": [
                            {
                                "ErrorEquals": ["States.ALL"],
                                "Next": "Prepare Failure Message",
                                "ResultPath": "$.error"
                            }
                        ],
                        "End": true
                    },
                    "Prepare Failure Message": {
                        "Type": "Pass",
                        "Parameters": {
                            "failureMessage": {
                                "executionId.$": "$$.Execution.Name",
                                "campaign_id.$": "$.Items[0].campaign_id",
                                "commit_id.$": "$.Items[0].commit_id",
                                "failedBatchSize.$": "States.ArrayLength($.Items)",
                                "error.$": "$.error.Cause",
                                "timestamp.$": "$$.State.EnteredTime",
                                "batchIndex.$": "$$.Map.Item.Index"
                            }
                        },
                        "Next": "Send Batch Failure to SQS"
                    },
                    "Send Batch Failure to SQS": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::sqs:sendMessage",
                        "Parameters": {
                            "QueueUrl": "${BatchFailureQueueUrl}",
                            "MessageBody.$": "States.JsonToString($.failureMessage)"
                        },
                        "ResultPath": "$.sqsResult",
                        "End": true
                    }
                }
            },
            "ItemReader": {
                "Resource": "arn:aws:states:::s3:getObject",
                "ReaderConfig": {
                    "InputType": "CSV",
                    "CSVHeaderLocation": "FIRST_ROW"
                },
                "Parameters": {
                    "Bucket.$": "$.Bucket",
                    "Key.$": "$.Key"
                }
            },
            "MaxConcurrency": ${MaxConcurrency},
            "Label": "S3CSVfileIngestion",
            "ToleratedFailurePercentage": 100,
            "ToleratedFailureCount": 10000,
            "ItemBatcher": {
                "MaxItemsPerBatch": 15
            },
            "Next": "Prepare Execution Summary",
            "Catch": [
                {
                    "ErrorEquals": ["States.ALL"],
                    "Next": "Prepare Execution Summary",
                    "ResultPath": "$.mapError"
                }
            ]
        },
        "Prepare Execution Summary": {
            "Type": "Pass",
            "Parameters": {
                "summaryMessage": {
                    "executionId.$": "$$.Execution.Name",
                    "totalBatches.$": "States.ArrayLength($)",
                    "successfulBatches.$": "States.ArrayLength($)",
                    "timestamp.$": "$$.State.EnteredTime",
                    "type": "EXECUTION_SUMMARY"
                },
                "originalData.$": "$",
                "campaign_id.$": "$campaign_id",
                "commit_id.$": "$commit_id"
            },
            "Next": "Send Execution Summary"
        },
        "Send Execution Summary": {
            "Type": "Task", 
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Parameters": {
                "QueueUrl": "${BatchFailureQueueUrl}",
                "MessageBody.$": "States.JsonToString($.summaryMessage)"
            },
            "ResultPath": "$.summaryResult",
            "Next": "Restore Data for Merge"
        },
        "Restore Data for Merge": {
            "Type": "Pass",
            "Parameters": {
                "data.$": "$.originalData",
                "campaign_id.$": "$campaign_id",
                "commit_id.$": "$commit_id"
            },
            "Next": "Merge CSV Data"
        },
        "Merge CSV Data": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${MergeCsvDataFunctionArn}",
                "Payload": {
                    "data.$": "$.data",
                    "executionId.$": "$$.Execution.Name",
                    "campaign_id.$": "$campaign_id",
                    "commit_id.$": "$commit_id"
                }
            },
            "End": true
        }
    }
}