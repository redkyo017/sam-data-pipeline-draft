{
    "Comment": "An enrichment pipeline that processes contact data with RocketReach and Apollo.io APIs",
    "StartAt": "Generate Commit ID",
    "States": {
        "Generate Commit ID": {
            "Type": "Pass",
            "Assign": {
                "campaign_id.$": "$.campaign_id",
                "commit_id.$": "States.UUID()"
            },
            "Parameters": {
                "Bucket.$": "$.bucket",
                "Key.$": "$.key",
                "campaign_id.$": "$.campaign_id"
            },
            "Next": "Count Total Records"
        },
        "Count Total Records": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${CountRecordsFunctionArn}",
                "Payload": {
                    "Bucket.$": "$.Bucket",
                    "Key.$": "$.Key"
                }
            },
            "Next": "Prepare Data for Processing"
        },
        "Prepare Data for Processing": {
            "Type": "Pass",
            "Assign": {
                "total_records.$": "$.Payload.totalRecords"
            },
            "Next": "S3 JSON file Enrichment"
        },
        "S3 JSON file Enrichment": {
            "Type": "Map",
            "Assign": {
                "campaign_id.$": "$campaign_id",
                "commit_id.$": "$commit_id",
                "total_records.$": "$total_records"
            },
            "ItemSelector": {
                "items.$": "$$.Map.Item.Value",
                "commit_id.$": "$commit_id",
                "campaign_id.$": "$campaign_id",
                "total_records.$": "$total_records"
            },
            "ItemProcessor": {
                "ProcessorConfig": {
                    "Mode": "DISTRIBUTED",
                    "ExecutionType": "STANDARD"
                },
                "StartAt": "Enrich Contact Data",
                "States": {
                    "Enrich Contact Data": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "ResultPath": "$.enrichment",
                        "Parameters": {
                            "FunctionName": "${EnrichmentProcessorFunctionArn}",
                            "Payload.$": "$"
                        },
                        "Catch": [
                            {
                                "ErrorEquals": ["States.ALL"],
                                "Next": "Prepare Failure Message",
                                "ResultPath": "$.error"
                            }
                        ],
                        "Next": "Prepare Batch Progress Message"
                    },
                    "Prepare Batch Progress Message": {
                        "Type": "Pass",
                        "Parameters": {
                            "progressMessage": {
                                "execution_id.$": "$$.Execution.Name",
                                "campaign_id.$": "$.Items[0].campaign_id",
                                "commit_id.$": "$.Items[0].commit_id",
                                "timestamp.$": "$$.State.EnteredTime",
                                "current.$": "States.ArrayLength($.Items)",
                                "total.$": "$.Items[0].total_records",
                                "status": "running",
                                "pipeline": "enrichment",
                                "step": "batch_processing",
                                "metadata": {
                                    "type": "BATCH_PROGRESS",
                                    "batchSize.$": "States.ArrayLength($.Items)",
                                    "processingStage": "enrichment_complete"
                                }
                            }
                        },
                        "Next": "Send Batch Progress to SQS"
                    },
                    "Send Batch Progress to SQS": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::sqs:sendMessage",
                        "Parameters": {
                            "QueueUrl": "${BatchFailureQueueUrl}",
                            "MessageBody.$": "States.JsonToString($.progressMessage)"
                        },
                        "ResultPath": "$.progressResult",
                        "End": true
                    },
                    "Prepare Failure Message": {
                        "Type": "Pass",
                        "Parameters": {
                            "failureMessage": {
                                "execution_id.$": "$$.Execution.Name",
                                "campaign_id.$": "$.Items[0].campaign_id",
                                "commit_id.$": "$.Items[0].commit_id", 
                                "timestamp.$": "$$.State.EnteredTime",
                                "current.$": "States.ArrayLength($.Items)",
                                "total.$": "$.Items[0].total_records",
                                "status": "failed",
                                "pipeline": "enrichment",
                                "step": "batch_processing",
                                "error": {
                                    "cause.$": "$.error.Cause",
                                    "error.$": "$.error.Error"
                                }
                            }
                        },
                        "Next": "Send Failure to Both Queues"
                    },
                    "Send Failure to Both Queues": {
                        "Type": "Parallel",
                        "Branches": [
                            {
                                "StartAt": "Send to Progress Queue",
                                "States": {
                                    "Send to Progress Queue": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::sqs:sendMessage",
                                        "Parameters": {
                                            "QueueUrl": "${BatchFailureQueueUrl}",
                                            "MessageBody.$": "States.JsonToString($.failureMessage)"
                                        },
                                        "End": true
                                    }
                                }
                            },
                            {
                                "StartAt": "Send to Dead Letter Queue",
                                "States": {
                                    "Send to Dead Letter Queue": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::sqs:sendMessage",
                                        "Parameters": {
                                            "QueueUrl": "${ProcessingDeadLetterQueueUrl}",
                                            "MessageBody.$": "States.JsonToString($.failureMessage)"
                                        },
                                        "End": true
                                    }
                                }
                            }
                        ],
                        "End": true
                    }
                }
            },
            "ItemReader": {
                "Resource": "arn:aws:states:::s3:getObject",
                "ReaderConfig": {
                    "InputType": "JSON"
                },
                "Parameters": {
                    "Bucket.$": "$.Payload.Bucket",
                    "Key.$": "$.Payload.Key"
                }
            },
            "MaxConcurrency": ${MaxConcurrency},
            "Label": "S3JSONfileEnrichment",
            "ToleratedFailurePercentage": 100,
            "ToleratedFailureCount": 10000,
            "ItemBatcher": {
                "MaxItemsPerBatch": 100
            },
            "Next": "Prepare Execution Summary",
            "Catch": [
                {
                    "ErrorEquals": ["States.ALL"],
                    "Next": "Prepare Execution Summary",
                    "ResultPath": "$.mapError"
                }
            ]
        },
        "Prepare Execution Summary": {
            "Type": "Pass",
            "Parameters": {
                "summaryMessage": {
                    "execution_id.$": "$$.Execution.Name",
                    "campaign_id.$": "$campaign_id",
                    "commit_id.$": "$commit_id",
                    "timestamp.$": "$$.State.EnteredTime",
                    "current.$": "$total_records",
                    "total.$": "$total_records",
                    "status": "completed",
                    "pipeline": "enrichment",
                    "step": "execution_complete",
                    "metadata": {
                        "type": "EXECUTION_SUMMARY",
                        "totalBatches.$": "States.ArrayLength($)",
                        "totalRecords.$": "$total_records"
                    }
                },
                "originalData.$": "$",
                "campaign_id.$": "$campaign_id",
                "commit_id.$": "$commit_id"
            },
            "Next": "Send Execution Summary"
        },
        "Send Execution Summary": {
            "Type": "Task", 
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Parameters": {
                "QueueUrl": "${BatchFailureQueueUrl}",
                "MessageBody.$": "States.JsonToString($.summaryMessage)"
            },
            "ResultPath": "$.summaryResult",
            "Next": "Restore Data for Merge"
        },
        "Restore Data for Merge": {
            "Type": "Pass",
            "Parameters": {
                "data.$": "$.originalData",
                "campaign_id.$": "$campaign_id",
                "commit_id.$": "$commit_id"
            },
            "Next": "Merge Enriched Data"
        },
        "Merge Enriched Data": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${EnrichmentMergerFunctionArn}",
                "Payload": {
                    "data.$": "$.data",
                    "executionId.$": "$$.Execution.Name",
                    "campaign_id.$": "$.campaign_id",
                    "commit_id.$": "$.commit_id"
                }
            },
            "Catch": [
                {
                    "ErrorEquals": ["States.ALL"],
                    "Next": "Handle Merge Failure",
                    "ResultPath": "$.mergeError"
                }
            ],
            "End": true
        },
        "Handle Merge Failure": {
            "Type": "Pass",
            "Parameters": {
                "failureMessage": {
                    "execution_id.$": "$$.Execution.Name",
                    "campaign_id.$": "$.campaign_id",
                    "commit_id.$": "$.commit_id",
                    "timestamp.$": "$$.State.EnteredTime",
                    "current.$": "$total_records",
                    "total.$": "$total_records",
                    "status": "failed",
                    "pipeline": "enrichment",
                    "error": {
                        "cause.$": "$.mergeError.Cause",
                        "error.$": "$.mergeError.Error"
                    },
                    "metadata": {
                        "type": "MERGE_FAILURE",
                        "stage": "post-enrichment"
                    }
                }
            },
            "Next": "Send Merge Failure to SQS"
        },
        "Send Merge Failure to SQS": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Parameters": {
                "QueueUrl": "${BatchFailureQueueUrl}",
                "MessageBody.$": "States.JsonToString($.failureMessage)"
            },
            "ResultPath": "$.sqsResult",
            "End": true
        }
    }
}
