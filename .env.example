# Environment Variables for SAM Data Pipeline
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
# Required for data standardization pipeline
# Note: Invalid keys will trigger systemic failure detection and route to failure queue
OPENAI_API_KEY=your_openai_api_key_here

# VENDOR API KEYS FOR LOCAL DEVELOPMENT
# Set these to use actual API keys instead of SSM parameters for local testing
# Note: Enrichment pipeline handles vendor API failures gracefully (no systemic failure detection)
ROCKETREACH_STAGING_KEY=""
APOLLO_STAGING_KEY=""

# AWS S3 Configuration
INPUT_BUCKET_NAME=sam-data-pipeline-input-bucket-staging
OUTPUT_BUCKET_NAME=sam-data-pipeline-output-bucket-staging

# AWS Region (default: ap-southeast-1)
AWS_DEFAULT_REGION=ap-southeast-1

# Development/Testing Configuration
# Set to 'true' for local testing with Step Functions Local
LOCAL_TESTING=false

# Monitoring & Debugging Configuration
# These URLs will be auto-generated after deployment, add them here for easy access
# PROGRESS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/sam-data-pipeline-dev-BatchFailureQueue
# DEAD_LETTER_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/sam-data-pipeline-dev-ProcessingDeadLetterQueue

# Error Handling Configuration
# SYSTEMIC_FAILURE_DETECTION=enabled    # Controls whether systemic failures trigger failure queue
# PROGRESS_TRACKING=enabled             # Controls whether progress messages are sent to SQS