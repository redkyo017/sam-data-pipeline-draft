# Environment Variables for SAM Data Pipeline
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# VENDOR API KEYS FOR LOCAL DEVELOPMENT
# Set these to use actual API keys instead of SSM parameters for local testing
ROCKETREACH_STAGING_KEY=""
APOLLO_STAGING_KEY=""

# AWS S3 Configuration
# INPUT_BUCKET_NAME=sam-data-pipeline-input-bucket-staging
# OUTPUT_BUCKET_NAME=sam-data-pipeline-output-bucket-staging
INPUT_BUCKET_BASE_NAME="sam-data-pipeline-input-bucket" 
OUTPUT_BUCKET_BASE_NAME="sam-data-pipeline-output-bucket"

# AWS Region (default: ap-southeast-1)
AWS_DEFAULT_REGION=ap-southeast-1

# Development/Testing Configuration
# Set to 'true' for local testing with Step Functions Local
LOCAL_TESTING=false